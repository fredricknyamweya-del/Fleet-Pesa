# Flask
FLASK_APP=app.py
FLASK_DEBUG=0
SECRET_KEY=replace_with_a_long_random_string

# Database (SQLite)
DATABASE_URL=sqlite:///fleetpesa.db

# JWT
JWT_SECRET_KEY=replace_with_a_long_random_string_min_32_bytes

# M-Pesa Daraja (sandbox)
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
MPESA_CALLBACK_URL=https://your-ngrok-or-deployed-url/api/fare-payments/mpesa-callback
MPESA_ENV=sandbox

# M-Pesa callback protection (interim, until full signature verification)
MPESA_CALLBACK_SECRET=replace_with_a_shared_secret

# Frontend (used by frontend/.env, not backend, but often documented together)
VITE_API_URL=http://localhost:5000/api